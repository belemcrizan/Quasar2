        "hikari pool",
        "max connections",
        "wait timeout"
      ],
      "discriminators": [
        "active equals max",
        "idle zero",
        "pg_stat_activity"
      ],
      "aliases": [
        "pool exhausted",
        "cannot get connection",
        "too many clients"
      ]
    },
    {
      "id": "ops.deploy_bad_canary",
      "domain": "ops",
